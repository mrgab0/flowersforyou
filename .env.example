# Contraseña del Panel de Administración
ADMIN_PASSWORD=flores2026

# URL Base del Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini API Key (Para el Chatbot Asistente Floral IA)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

